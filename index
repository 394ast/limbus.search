const state = {
  identity: [],
  ego: []
};

const OP_TEXT = {
  NOT: "¬",
  AND: "∧",
  OR: "∨",
  LPAREN: "(",
  RPAREN: ")"
};

function conditionToken(label, fn) {
  return { type: "condition", label, fn };
}
function opToken(type) {
  return { type: "op", value: type };
}

function addToken(mode, token) {
  state[mode].push(token);
  renderExpression(mode);
}

function renderExpression(mode) {
  const el = document.getElementById(mode === "identity" ? "identityExpression" : "egoExpression");
  const tokens = state[mode];
  el.innerHTML = "";
  if (!tokens.length) {
    el.innerHTML = '<span class="empty-expression">ここに条件が入ります</span>';
    return;
  }
  for (const token of tokens) {
    const span = document.createElement("span");
    span.className = "token" + (token.type === "op" ? " op" : "");
    span.textContent = token.type === "op" ? OP_TEXT[token.value] : token.label;
    el.appendChild(span);
  }
}

function compare(a, op, b) {
  switch (op) {
    case "<=": return a <= b;
    case "<":  return a < b;
    case "=":  return a === b;
    case ">":  return a > b;
    case ">=": return a >= b;
    default: throw new Error("比較演算子が不正です。");
  }
}

function parseExpression(tokens) {
  let pos = 0;

  function peek() {
    return tokens[pos];
  }

  function consume() {
    return tokens[pos++];
  }

  function parseOr() {
    let left = parseAnd();
    while (peek()?.type === "op" && peek().value === "OR") {
      consume();
      const right = parseAnd();
      const oldLeft = left;
      left = row => oldLeft(row) || right(row);
    }
    return left;
  }

  function parseAnd() {
    let left = parseUnary();
    while (peek()?.type === "op" && peek().value === "AND") {
      consume();
      const right = parseUnary();
      const oldLeft = left;
      left = row => oldLeft(row) && right(row);
    }
    return left;
  }

  function parseUnary() {
    if (peek()?.type === "op" && peek().value === "NOT") {
      consume();
      const target = parseUnary();
      return row => !target(row);
    }
    return parsePrimary();
  }

  function parsePrimary() {
    const token = peek();
    if (!token) {
      throw new Error("条件が必要な場所で式が終わっています。");
    }

    if (token.type === "condition") {
      consume();
      return token.fn;
    }

    if (token.type === "op" && token.value === "LPAREN") {
      consume();
      const inside = parseOr();
      const close = consume();
      if (!close || close.type !== "op" || close.value !== "RPAREN") {
        throw new Error("「(」に対応する「)」がありません。");
      }
      return inside;
    }

    throw new Error("この位置には条件または「(」が必要です。");
  }

  const fn = parseOr();

  if (pos < tokens.length) {
    const t = tokens[pos];
    if (t.type === "op" && t.value === "RPAREN") {
      throw new Error("対応する「(」がない「)」があります。");
    }
    throw new Error("論理式のつなぎ方が不正です。");
  }
  return fn;
}

function setError(mode, message) {
  document.getElementById(mode === "identity" ? "identityError" : "egoError").textContent = message || "";
}

function setCount(mode, count) {
  document.getElementById(mode === "identity" ? "identityCount" : "egoCount").textContent =
    `該当件数: ${count}`;
}

function renderResults(mode, rows) {
  const resultEl = document.getElementById(mode === "identity" ? "identityResults" : "egoResults");
  resultEl.innerHTML = "";

  const groups = mode === "identity" ? IDENTITY_GROUPS : EGO_GROUPS;
  const basePath = mode === "identity"
    ? "https://raw.githubusercontent.com/394ast/limbus.sharetool/main/Identities.After/"
    : "https://raw.githubusercontent.com/394ast/limbus.sharetool/main/EGO/";

  for (const [baseId, sinner] of groups) {
    const matched = rows
      .filter(row => {
        const id = Number(row.id);
        return id >= baseId && id < baseId + 1000;
      })
      .sort((a, b) => Number(a.id) - Number(b.id));

    const group = document.createElement("div");
    group.className = "result-group";

    const title = document.createElement("h3");
    title.textContent = `${baseId}番台：${sinner}`;
    group.appendChild(title);

    if (!matched.length) {
      const none = document.createElement("div");
      none.className = "no-result";
      none.textContent = `${sinner}：該当なし`;
      group.appendChild(none);
    } else {
      const rowEl = document.createElement("div");
      rowEl.className = "result-row";

      for (const item of matched) {
        const card = document.createElement("div");
        card.className = "card";

        const img = document.createElement("img");
        img.src = `${basePath}${item.id}.${mode === "identity" ? "3.jpg" : "jpg"}`;
        img.alt = `${item.name1} ${item.name2}`;
        img.loading = "lazy";

        const name = document.createElement("div");
        name.className = "card-name";
        name.textContent = `${item.name1} / ${item.name2}`;

        const id = document.createElement("div");
        id.className = "card-id";
        id.textContent = `ID: ${item.id}`;

        card.appendChild(img);
        card.appendChild(name);
        card.appendChild(id);
        rowEl.appendChild(card);
      }
      group.appendChild(rowEl);
    }

    resultEl.appendChild(group);
  }
}

