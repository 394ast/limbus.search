    document.getElementById(mode === "identity" ? "identityResults" : "egoResults").innerHTML = "";
    setError(mode, "論理式を作成してください。");
    return;
  }

  try {
    const predicate = parseExpression(state[mode]);
    const data = mode === "identity" ? IDENTITY_DATA : EGO_DATA;
    const minId = mode === "identity" ? 1001 : 13001;
    const maxId = mode === "identity" ? 13001 : 25001;

    const matched = data.filter(row => {
      const id = Number(row.id);
      return id >= minId && id < maxId && predicate(row);
    });

    setCount(mode, matched.length);
    renderResults(mode, matched);
  } catch (e) {
    setCount(mode, 0);
    document.getElementById(mode === "identity" ? "identityResults" : "egoResults").innerHTML = "";
    setError(mode, e.message);
  }
}

function reset(mode) {
  state[mode] = [];
  renderExpression(mode);
  setError(mode, "");
  setCount(mode, 0);
  document.getElementById(mode === "identity" ? "identityResults" : "egoResults").innerHTML = "";
}

