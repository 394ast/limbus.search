<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>リンバス人格・E.G.O検索</title>
<style>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #f5f5f5;
    color: #222;
  }
  .page {
    max-width: 1500px;
    margin: 0 auto;
    padding: 16px;
  }
  h1 {
    margin: 0 0 14px;
    font-size: 24px;
  }
  .tabs {
    display: flex;
    gap: 6px;
    margin-bottom: 14px;
  }
  .tab-button {
    border: 1px solid #aaa;
    background: #fff;
    padding: 9px 18px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 15px;
  }
  .tab-button.active {
    background: #222;
    color: #fff;
    border-color: #222;
  }
  .panel {
    display: none;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 10px;
    padding: 14px;
    box-shadow: 0 1px 3px rgba(0,0,0,.05);
  }
  .panel.active { display: block; }

  .control-section {
    margin-bottom: 14px;
  }
  .section-title {
    font-weight: 700;
    margin-bottom: 8px;
  }
  .button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    align-items: center;
  }
  button {
    font: inherit;
  }
  .op-button, .condition-button {
    border: 1px solid #aaa;
    background: #fafafa;
    border-radius: 7px;
    padding: 7px 10px;
    cursor: pointer;
  }
  .op-button:hover, .condition-button:hover {
    background: #eee;
  }
  .condition-group {
    display: inline-flex;
    gap: 4px;
    align-items: center;
    border: 1px solid #ddd;
    padding: 4px;
    border-radius: 8px;
    background: #fafafa;
  }
  select, input[type="number"] {
    font: inherit;
    padding: 6px 8px;
    border: 1px solid #bbb;
    border-radius: 6px;
    background: #fff;
  }
  input[type="number"] {
    width: 92px;
  }

  .expression-box {
    border: 1px solid #bbb;
    border-radius: 8px;
    min-height: 52px;
    padding: 10px;
    background: #fcfcfc;
    margin: 8px 0 10px;
    word-break: break-word;
    line-height: 1.8;
  }
  .token {
    display: inline-block;
    margin: 2px;
    padding: 3px 7px;
    border-radius: 5px;
    background: #ececec;
    font-size: 14px;
  }
  .token.op {
    background: #ddd;
    font-weight: 700;
  }
  .empty-expression {
    color: #888;
  }

  .action-row {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-bottom: 12px;
  }
  .search-button, .reset-button {
    border: 0;
    border-radius: 7px;
    padding: 9px 16px;
    cursor: pointer;
    color: #fff;
  }
  .search-button { background: #1f6feb; }
  .reset-button { background: #666; }
  .search-button:hover { background: #1757b8; }
  .reset-button:hover { background: #4e4e4e; }
  .result-count {
    font-weight: 700;
  }
  .error {
    color: #b00020;
    margin: 8px 0;
    white-space: pre-wrap;
  }

  .result-group {
    margin-top: 18px;
  }
  .result-group h3 {
    margin: 0 0 8px;
    font-size: 17px;
  }
  .result-row {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding-bottom: 8px;
  }
  .card {
    flex: 0 0 auto;
    width: 120px;
    text-align: center;
  }
  .card img {
    display: block;
    width: 120px;
    height: auto;
    border: 1px solid #ccc;
    border-radius: 5px;
    background: #eee;
  }
  .card-name {
    margin-top: 4px;
    font-size: 12px;
    line-height: 1.3;
  }
  .card-id {
    color: #666;
    font-size: 11px;
  }
  .no-result {
    color: #777;
    padding: 8px 0;
  }

  @media (max-width: 700px) {
    .page { padding: 10px; }
    .card, .card img { width: 96px; }
    .panel { padding: 10px; }
  }
</style>
</head>
<body>
<div class="page">
  <h1>リンバス人格・E.G.O検索</h1>

  <div class="tabs">
    <button class="tab-button active" data-tab="identity">人格検索</button>
    <button class="tab-button" data-tab="ego">EGO検索</button>
  </div>

  <section id="identityPanel" class="panel active">
    <div class="control-section">
      <div class="section-title">論理演算子</div>
      <div class="button-row">
        <button class="op-button" data-mode="identity" data-token="NOT">¬</button>
        <button class="op-button" data-mode="identity" data-token="AND">∧</button>
        <button class="op-button" data-mode="identity" data-token="OR">∨</button>
        <button class="op-button" data-mode="identity" data-token="LPAREN">(</button>
        <button class="op-button" data-mode="identity" data-token="RPAREN">)</button>
      </div>
    </div>

    <div class="control-section">
      <div class="section-title">人格の条件</div>
      <div class="button-row">
        <div class="condition-group">
          <select id="idPhysicalSelect">
            <option value="斬撃">斬撃</option>
            <option value="貫通">貫通</option>
            <option value="打撃">打撃</option>
          </select>
          <button class="condition-button" id="idResistButton">耐性</button>
        </div>

        <div class="condition-group">
          <select id="idWeakSelect">
            <option value="斬撃">斬撃</option>
            <option value="貫通">貫通</option>
            <option value="打撃">打撃</option>
          </select>
          <button class="condition-button" id="idWeakButton">脆弱</button>
        </div>

        <div class="condition-group">
          <select id="idDefenseSelect">
            <option value="防御">ガード</option>
            <option value="回避">回避</option>
            <option value="反撃">反撃</option>
            <option value="M防御">マッチ可能ガード</option>
            <option value="M反撃">マッチ可能反撃</option>
          </select>
          <button class="condition-button" id="idDefenseButton">条件追加</button>
        </div>

        <div class="condition-group">
          <select id="idSinSelect">
            <option value="憤怒">憤怒</option>
            <option value="色欲">色欲</option>
            <option value="怠惰">怠惰</option>
            <option value="暴食">暴食</option>
            <option value="憂鬱">憂鬱</option>
            <option value="傲慢">傲慢</option>
            <option value="嫉妬">嫉妬</option>
          </select>
          <button class="condition-button" id="idSinButton">属性条件追加</button>
        </div>

        <div class="condition-group">
          <select id="idEffectSelect">
            <option value="火傷">火傷</option>
            <option value="出血">出血</option>
            <option value="振動">振動</option>
            <option value="破裂">破裂</option>
            <option value="沈潜">沈潜</option>
            <option value="呼吸">呼吸</option>
            <option value="充電">充電</option>
          </select>
          <button class="condition-button" id="idEffectButton">状態条件追加</button>
        </div>
      </div>
    </div>

    <div class="section-title">論理式</div>
    <div id="identityExpression" class="expression-box">
      <span class="empty-expression">ここに条件が入ります</span>
    </div>

    <div class="action-row">
      <button id="identitySearchButton" class="search-button">検索</button>
      <button id="identityResetButton" class="reset-button">リセット</button>
      <span id="identityCount" class="result-count"></span>
    </div>
    <div id="identityError" class="error"></div>
    <div id="identityResults"></div>
  </section>

  <section id="egoPanel" class="panel">
    <div class="control-section">
      <div class="section-title">論理演算子</div>
      <div class="button-row">
        <button class="op-button" data-mode="ego" data-token="NOT">¬</button>
        <button class="op-button" data-mode="ego" data-token="AND">∧</button>
        <button class="op-button" data-mode="ego" data-token="OR">∨</button>
        <button class="op-button" data-mode="ego" data-token="LPAREN">(</button>
        <button class="op-button" data-mode="ego" data-token="RPAREN">)</button>
      </div>
    </div>

    <div class="control-section">
      <div class="section-title">EGOの条件</div>
      <div class="button-row">
        <div class="condition-group">
          <select id="egoRankSelect">
            <option value="1">ZAYIN</option>
            <option value="2">TETH</option>
            <option value="3">HE</option>
            <option value="4">WAW</option>
            <option value="5">ALEPH</option>
          </select>
          <button class="condition-button" id="egoRankButton">ランク追加</button>
        </div>

        <div class="condition-group">
          <select id="egoCostSinSelect">
            <option value="憤怒">憤怒</option>
            <option value="色欲">色欲</option>
            <option value="怠惰">怠惰</option>
            <option value="暴食">暴食</option>
            <option value="憂鬱">憂鬱</option>
            <option value="傲慢">傲慢</option>
            <option value="嫉妬">嫉妬</option>
          </select>
          <span>消費</span>
          <input id="egoCostValue" type="number" min="0" step="1" value="0">
          <select id="egoCostOp">
            <option value="<=">以下</option>
            <option value="<">より少ない</option>
            <option value="=">に等しい</option>
            <option value=">">より多い</option>
            <option value=">=">以上</option>
          </select>
          <button class="condition-button" id="egoCostButton">条件追加</button>
        </div>

        <div class="condition-group">
          <select id="egoResistSinSelect">
            <option value="憤怒">憤怒</option>
            <option value="色欲">色欲</option>
            <option value="怠惰">怠惰</option>
            <option value="暴食">暴食</option>
            <option value="憂鬱">憂鬱</option>
            <option value="傲慢">傲慢</option>
            <option value="嫉妬">嫉妬</option>
          </select>
          <span>耐性が</span>
          <select id="egoResistValue">
            <option value="0.5">0.5</option>
            <option value="0.75">0.75</option>
            <option value="1">1</option>
            <option value="2">2</option>
          </select>
          <select id="egoResistOp">
            <option value="<=">以下</option>
            <option value="<">より少ない</option>
            <option value="=">に等しい</option>
            <option value=">">より多い</option>
            <option value=">=">以上</option>
          </select>
          <button class="condition-button" id="egoResistButton">条件追加</button>
        </div>
      </div>
    </div>

    <div class="section-title">論理式</div>
    <div id="egoExpression" class="expression-box">
      <span class="empty-expression">ここに条件が入ります</span>
    </div>

    <div class="action-row">
      <button id="egoSearchButton" class="search-button">検索</button>
      <button id="egoResetButton" class="reset-button">リセット</button>
      <span id="egoCount" class="result-count"></span>
    </div>
    <div id="egoError" class="error"></div>
    <div id="egoResults"></div>
  </section>
</div>

