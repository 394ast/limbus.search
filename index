  if (!Number.isInteger(value) || value < 0) {
    setError("ego", "消費値は0以上の整数にしてください。");
    return;
  }

  const labelOp = { "<=": "以下", "<": "より少ない", "=": "に等しい", ">": "より多い", ">=": "以上" }[op];
  addToken("ego", conditionToken(`[${sin}]消費${value}${labelOp}`, row => compare(Number(row[sin]), op, value)));
});

